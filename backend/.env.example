# Settings for running the backend directly. Compose overrides DB_* and CORS.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=likehome_db
DB_USER=likehome
DB_PASSWORD=match-MYSQL_PASSWORD-in-the-root-env

EXTERNAL_API_URL=https://serpapi.com/search?engine=google_hotels
API_KEY=

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
